{
  "manifest_version": 3,
  "name": "Log Pose",
  "version": "1.1.0",
  "description": "Track your One Piece anime progress by arc and plan your weekly catch-up schedule.",
  "permissions": ["storage", "sidePanel", "identity", "alarms", "notifications"],
  "host_permissions": [
    "https://api.jikan.moe/*",
    "https://*.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "102089007368-fguhuehgusmp1afhp14in1hcr83c3e4t.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "action": {
    "default_title": "Log Pose"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
